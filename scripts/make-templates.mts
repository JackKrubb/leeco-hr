// Builds the downloadable Excel templates in public/templates.
// Usage: npx tsx scripts/make-templates.mts
import ExcelJS from "exceljs";

const headerStyle = (row: ExcelJS.Row) => {
  row.font = { bold: true, color: { argb: "FFFFFFFF" } };
  row.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FF1F2A37" } };
  row.alignment = { vertical: "middle" };
  row.height = 22;
};

// ---------------------------------------------------------------- employees
{
  const wb = new ExcelJS.Workbook();
  const ws = wb.addWorksheet("พนักงาน");
  ws.columns = [
    { header: "ลำดับ", width: 7 },
    { header: "รหัสพนักงาน", width: 13 },
    { header: "คำนำหน้า", width: 10 },
    { header: "ชื่อ", width: 16 },
    { header: "นามสกุล", width: 18 },
    { header: "ชื่อเล่น", width: 10 },
    { header: "ฝ่าย", width: 12 },
    { header: "แผนก", width: 12 },
    { header: "ตำแหน่ง", width: 14 },
    { header: "บริษัท", width: 10 },
    { header: "วันเริ่มงาน", width: 13 },
    { header: "หมายเหตุ", width: 28 },
  ];
  headerStyle(ws.getRow(1));
  ws.addRow([1, "", "นาย", "สมชาย", "ตัวอย่าง", "ชาย", "พับ", "พับ", "พนักงาน", "เฮง", "1/6/69", "ลบแถวตัวอย่างนี้ก่อนอัปโหลด"]);
  ws.addRow([2, "", "น.ส.", "สมหญิง", "ตัวอย่าง", "", "ออฟฟิศ", "บัญชี", "บัญชี", "JPP", "15/1/68", ""]);
  ws.getColumn(11).numFmt = "@";
  const notes = wb.addWorksheet("วิธีใช้");
  [
    "• รหัสพนักงาน: เว้นว่างได้ ระบบจะสร้างให้ (E001, E002 …) และจับคู่คนเดิมจากชื่อ+นามสกุล",
    "• วันเริ่มงาน: ใส่ได้ทั้ง 6/3/67, 06/03/2567, 2024-03-06 หรือเป็นวันที่ของ Excel",
    "• บริษัท: เฮง / JPP / จิรสิน / นอกระบบ (ข้อความเพิ่มเติม เช่น ค่าตำแหน่ง จะไปอยู่ในหมายเหตุ)",
    "• ช่องที่เว้นว่าง จะไม่ลบข้อมูลเดิมในระบบ",
    "• ไม่ต้องใส่ค่าแรง/เงินเดือน — ระบบไม่นำเข้าคอลัมน์นี้",
    "• ไฟล์รายชื่อแบบเดิมของ HR (มีหัวแผนก, ,, แทนข้อมูลซ้ำ) ก็อัปโหลดได้เลย",
  ].forEach((t) => notes.addRow([t]));
  notes.getColumn(1).width = 100;
  await wb.xlsx.writeFile("public/templates/employees-template.xlsx");
}

