# Supabase project → Settings → API. Both values are safe to ship to the browser:
# the database only exposes the hr_* functions, which check the login token themselves.
# Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Path the site is served under (GitHub Pages project site). Use "" for a root domain.
NEXT_PUBLIC_BASE_PATH=/leeco-hr
